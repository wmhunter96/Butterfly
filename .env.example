# Leave the three ACTUAL_* values empty to run with demo data.
ACTUAL_SERVER_URL=http://192.168.1.10:5006
ACTUAL_PASSWORD=
# Settings > Advanced settings > Sync ID in Actual
ACTUAL_SYNC_ID=
# Only if your budget file uses end-to-end encryption
ACTUAL_ENCRYPTION_PASSWORD=
# Optional: require a password to open Butterfly
APP_PASSWORD=
# How long to cache data from Actual between page loads
CACHE_SECONDS=60
# Optional: Claude API key for "Categorize with AI" (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: Claude model for AI categorization
AI_MODEL=claude-opus-5
